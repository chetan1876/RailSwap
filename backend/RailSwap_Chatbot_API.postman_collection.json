{
  "info": {
    "_postman_id": "railswap-chatbot-v1",
    "name": "RailSwap AI Chatbot API",
    "description": "Complete API collection for the RailSwap AI Chatbot Module.\n\n## Setup\n1. Set `base_url` variable to `http://localhost:5000`\n2. Register or Login → the `token` variable is set automatically\n3. All chat endpoints use the token automatically\n\n## Get Gemini API Key\nhttps://aistudio.google.com/apikey",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000", "type": "string" },
    { "key": "token",    "value": "",                      "type": "string" },
    { "key": "session_id", "value": "default",             "type": "string" }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Register",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 201) {",
            "  const data = pm.response.json().data;",
            "  pm.collectionVariables.set('token', data.accessToken);",
            "  console.log('Token saved:', data.accessToken.slice(0,20) + '...');",
            "}"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@railswap.com\",\n  \"password\": \"Password123!\",\n  \"phone\": \"9876543210\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api","auth","register"] }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 200) {",
            "  const data = pm.response.json().data;",
            "  pm.collectionVariables.set('token', data.accessToken);",
            "  console.log('Logged in. Token saved.');",
            "}"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@railswap.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api","auth","login"] }
          },
          "response": []
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/auth/me", "host": ["{{base_url}}"], "path": ["api","auth","me"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "🤖 AI Chatbot",
      "item": [
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Can I exchange my seat?\",\n  \"sessionId\": \"{{session_id}}\",\n  \"sessionName\": \"My Journey\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/chat/message", "host": ["{{base_url}}"], "path": ["api","chat","message"] }
          },
          "response": []
        },
        {
          "name": "Send Message (Hindi)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"मेरी ट्रेन लेट है, क्या करूं?\",\n  \"sessionId\": \"{{session_id}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/chat/message", "host": ["{{base_url}}"], "path": ["api","chat","message"] }
          },
          "response": []
        },
        {
          "name": "Get Chat History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/chat/history?sessionId={{session_id}}&page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["api","chat","history"],
              "query": [
                { "key": "sessionId", "value": "{{session_id}}" },
                { "key": "page",      "value": "1" },
                { "key": "limit",     "value": "20" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get All Sessions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/chat/sessions", "host": ["{{base_url}}"], "path": ["api","chat","sessions"] }
          },
          "response": []
        },
        {
          "name": "Rename Session",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionName\": \"My Mumbai Journey\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/chat/session/{{session_id}}", "host": ["{{base_url}}"], "path": ["api","chat","session","{{session_id}}"] }
          },
          "response": []
        },
        {
          "name": "Delete Single Message",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/chat/:messageId", "host": ["{{base_url}}"], "path": ["api","chat",":messageId"],
              "variable": [{ "key": "messageId", "value": "REPLACE_WITH_REAL_MONGO_ID" }]
            }
          },
          "response": []
        },
        {
          "name": "Clear Chat History",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/chat/history?sessionId={{session_id}}",
              "host": ["{{base_url}}"],
              "path": ["api","chat","history"],
              "query": [{ "key": "sessionId", "value": "{{session_id}}" }]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "🔍 Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          },
          "response": []
        },
        {
          "name": "API Root",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/", "host": ["{{base_url}}"], "path": [""] }
          },
          "response": []
        }
      ]
    }
  ]
}
